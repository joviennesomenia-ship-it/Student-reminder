# --- Server ---
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (no trailing slash). Multiple origins: comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL on Neon/Supabase): change `provider` in prisma/schema.prisma to "postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Admin (single teacher account) ---
ADMIN_USERNAME=teacher
# Generate with: npm run hash-password -- "your-password"
# IMPORTANT: wrap the hash in single quotes so the $ characters are not expanded.
ADMIN_PASSWORD_HASH='$2a$12$replace.me.with.generated.hash'

# --- Auth tokens ---
# Use long random strings (e.g. `openssl rand -hex 48`). Never commit real values.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- File storage ---
# local | cloudinary | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# PUBLIC_BASE_URL is used to build file URLs for the local driver
PUBLIC_BASE_URL=http://localhost:4000

# Cloudinary (when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
